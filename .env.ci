# CI ortamı için TAMAMEN sahte/placeholder değerler — gerçek secret YOK,
# bu yüzden git'e commit'lenebilir (bkz. docs/adr/0026-ci-pipeline-scope.md).
#
# GitHub Actions job'larında `cat .env.ci >> "$GITHUB_ENV"` ile process
# env'e yüklenir — backend/config.py::Settings'in hardcoded
# `env_file=".env"` okumasına değil, gerçek ortam değişkenlerine güvenir
# (pydantic-settings gerçek env var'ları .env dosyasından önceliklidir).
#
# Postgres bölümündeki değerler .github/workflows/ci.yml'deki
# services.postgres.env bloğuyla BİREBİR eşleşmeli — services: container'ları
# job step'leri çalışmadan ÖNCE ayağa kalktığı için $GITHUB_ENV'i besleyemez,
# bu iki yer elle senkron tutulur.
APP_ENV=ci
DEBUG=false

# PostgreSQL — .github/workflows/ci.yml services.postgres ile eşleşmeli
DATABASE_URL=postgresql+asyncpg://ci_user:ci_password@localhost:5432/seekbind_ci
POSTGRES_USER=ci_user
POSTGRES_PASSWORD=ci_password
POSTGRES_DB=seekbind_ci

# Qdrant — CI'da requires_seed_data testleri hariç tutulduğu için gerçek
# bir collection'a hiç gidilmiyor, sadece Settings() zorunlu alanı
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=seekbind_providers_ci

# OpenAI — CI'da hiçbir gerçek OpenAI çağrısı yapılmıyor (requires_seed_data
# hariç tutuldu), bu key hiçbir zaman gerçek bir isteğe gitmiyor, sadece
# Settings()/istemci construction'ı için zorunlu alan
OPENAI_API_KEY=sk-ci-fake-not-a-real-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_ENRICHMENT_LLM_MODEL=gpt-4.1-mini

# Ollama — CI runner'ında native Ollama yok, requires_ollama testleri zaten
# hariç tutuluyor
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M

ACTIVE_LLM_PROVIDER=openai

# Jina AI (reranker) — sahte, gerçek çağrı yapılmıyor
JINA_API_KEY=jina-ci-fake-not-a-real-key

# SerpAPI (veri toplama scripti CI'da hiç çalışmıyor) — sahte
SERPAPI_API_KEY=serpapi-ci-fake-not-a-real-key

# Langfuse — CI'da gerçek bir Langfuse sunucusu ayağa kalkmıyor. Client
# construction'ı network çağrısı yapmıyor (lazy), lifespan() kapanışındaki
# .flush() de boş kuyrukta no-op olmalı (hiçbir CI-dahil test LLM çağrısı
# yapmıyor, kuyruğa hiçbir event yazılmıyor) — ilk gerçek CI çalıştırmasında
# job log'unda doğrulanacak.
LANGFUSE_PUBLIC_KEY=pk-lf-ci-fake
LANGFUSE_SECRET_KEY=sk-lf-ci-fake
LANGFUSE_HOST=http://localhost:3000

RATE_LIMIT_PER_MINUTE=60
LLM_MAX_CONCURRENT_CALLS=5

# Redis — .github/workflows/ci.yml services.redis ile eşleşmeli
REDIS_URL=redis://localhost:6379/0
ENABLE_CACHE=true

ENABLE_FALLBACK=true
